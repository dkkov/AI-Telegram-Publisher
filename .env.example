# Скопируй в .env для локальной сборки и добавь эти же переменные в Vercel.

# Telegram
TELEGRAM_BOT_TOKEN=          # токен от @BotFather
TELEGRAM_WEBHOOK_SECRET=     # придумай сам любую случайную строку (буквы/цифры)

# Gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Pexels (фото обложки)
PEXELS_API_KEY=

# Upstash Redis (лимит постов + память правок)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Лимит бесплатных постов на пользователя
FREE_POST_LIMIT=2
