# Copy to .env for local builds, and add the same variables in Vercel.

# Telegram
TELEGRAM_BOT_TOKEN=          # token from @BotFather
TELEGRAM_WEBHOOK_SECRET=     # make up any random string (letters/digits)

# Gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Pexels (cover photos)
PEXELS_API_KEY=

# Upstash Redis (post limit + edit memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Free posts per user
FREE_POST_LIMIT=2
